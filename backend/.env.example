# Copy this to .env and fill in your real values

# ── Gemini Flash (REQUIRED) ──────────────────────────────────────────────────
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Google Custom Search (OPTIONAL — enables web fallback) ───────────────────
# 1. Create API key: https://console.cloud.google.com → Enable "Custom Search API"
# 2. Create engine: https://programmablesearchengine.google.com
# Leave blank to skip web search (chatbot will say "not found" for unknown queries)
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# ── Embeddings (local, no API key needed) ───────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PATH=../data/chroma
CHROMA_COLLECTION=course_docs

# ── Chunking (tuned for Gemini Flash token budget) ───────────────────────────
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=4
MIN_RELEVANCE_SCORE=0.30

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme123

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=../data/uploads
